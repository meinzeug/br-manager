NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/var/lib/br-manager/br-manager.db
UPLOAD_DIR=/var/lib/br-manager/uploads
# Mindestens 32 zufällige Zeichen
SESSION_SECRET=change-me-with-openssl-rand-hex-32
# 32 Byte, Base64-kodiert: openssl rand -base64 32
FILE_ENCRYPTION_KEY=change-me-with-openssl-rand-base64-32
BOOTSTRAP_ADMIN_EMAIL=admin@betriebsrat.local
BOOTSTRAP_ADMIN_PASSWORD=set-a-strong-initial-password
BOOTSTRAP_COUNCIL_NAME=Betriebsrat Musterwerk
TRUST_PROXY=false
# Bei direktem lokalem HTTP-Zugriff false; hinter HTTPS-Reverse-Proxy true
COOKIE_SECURE=false
